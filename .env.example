# Frontend (client-safe, VITE_ prefixed)
# Keep blank in production/preview: the browser uses relative /api/* paths and
# Vercel rewrites them to Render, keeping the session cookie same-site.
# Set only for local development when calling the backend directly.
VITE_API_BASE_URL=
VITE_APP_ENV=
VITE_NIMIQ_NETWORK_LABEL=

# Backend (server-only)
NODE_ENV=
APP_ENV=
APP_ORIGIN=
API_PORT=
DATABASE_URL=
DATABASE_POOL_MAX=
AUTH_SESSION_SECRET=
AUTH_NONCE_TTL_SECONDS=
OPERATOR_ALLOWLIST_ADDRESSES=
OPERATOR_AUTH_SECRET=
NIMIQ_NETWORK=
# Comma-separated Nimiq Web Client seed URLs; defaults to the verified TestAlbatross seed.
NIMIQ_SEED_NODES=
NIMIQ_TREASURY_ADDRESS=
NIMIQ_TREASURY_PRIVATE_KEY=
NIMIQ_DEMO_AGENT_ADDRESS=
NIMIQ_DEMO_AGENT_PRIVATE_KEY=
NIMIQ_EXPLORER_BASE_URL=
FUNDING_MINIMUM_LUNA=
REWARD_PER_ANSWER_LUNA=
MAX_CONSULTATIONS_PER_SESSION=
PAYOUT_WORKER_ENABLED=
DEMO_FUNDING_ENABLED=
PREVIEW_MOCK_AUTH_ENABLED=
LOG_LEVEL=

# Tests only (not used by the API runtime)
LBA_INTEGRATION_DATABASE_URL=
PHASE4_E2E_BASE_URL=
PHASE4_EXPECTED_PUBLIC_REF=
