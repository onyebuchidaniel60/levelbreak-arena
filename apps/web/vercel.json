{
  "framework": "vite",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://levelbreak-arena.onrender.com/api/:path*"
    },
    {
      "source": "/health/:path*",
      "destination": "https://levelbreak-arena.onrender.com/health/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
