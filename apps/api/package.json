    "@fastify/cors": "11.3.1",
    "@fastify/rate-limit": "11.2.2",
    "@nimiq/core": "2.23.0",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
